<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.forwardmeasure.authzen</groupId>
        <artifactId>forwardmeasure-authzen-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>forwardmeasure-authzen-api</artifactId>
    <name>ForwardMeasure AuthZEN :: API</name>
    <description>
        The generic AuthZEN transport contract - AuthorizationService/AuthorizationRequest/
        AuthorizationDecision, ActiveOrganization/ActiveOrganizationProvider, Keycloak JWT-claims
        extraction. AuthorizationRequest#action is a plain String (the resolved "resource:verb"
        scope) rather than a typed enum - the enum itself is inherently per-product vocabulary and
        stays local to each consuming product; this module only needs the string it produces.
        AuthorizationResource is likewise a generic (type, id, properties) record with no static
        factory methods here - each product supplies its own.
    </description>
    <dependencies>
        <dependency>
            <groupId>com.forwardmeasure.jpa</groupId>
            <artifactId>forwardmeasure-jpa-tenancy</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
