<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.forwardmeasure.authzen</groupId>
        <artifactId>forwardmeasure-authzen-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>forwardmeasure-authzen-testkit</artifactId>
    <name>ForwardMeasure AuthZEN :: Test Kit</name>
    <description>
        StubAuthorizationService - a real, explicit test-only PDP stand-in, permissive or
        deny-by-default per test. Ported from forwardmeasure-openworkflow's real
        openworkflow-authorization-testkit. AuthzenKeycloakFixture - a real, generic Keycloak 26.7
        Organizations+AuthZEN fixture (provisions real Organizations/roles/groups and real
        Authorization Services resources/scopes/policies/permissions via the Admin REST API, mints
        real signed JWTs), generalized from that same origin module's own
        KeycloakOrganizationFixture (which stayed there, product-specific to Human Task resources) -
        this is what forwardmeasure-authzen-client's own real Keycloak integration test is built on.
    </description>
    <dependencies>
        <dependency>
            <groupId>com.forwardmeasure.authzen</groupId>
            <artifactId>forwardmeasure-authzen-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.testcontainers</groupId>
            <artifactId>forwardmeasure-testcontainers-keycloak</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
