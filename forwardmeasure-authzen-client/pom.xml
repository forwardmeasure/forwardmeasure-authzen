<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.forwardmeasure.authzen</groupId>
        <artifactId>forwardmeasure-authzen-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>forwardmeasure-authzen-client</artifactId>
    <name>ForwardMeasure AuthZEN :: Keycloak Client</name>
    <description>
        The real, fail-closed Keycloak 26.7 AuthZEN Evaluation/Evaluations HTTP adapter, plus an
        OAuth2 client-credentials bearer-token supplier - ported from forwardmeasure-openworkflow's
        real openworkflow-authorization-authzen. Framework-neutral: AuthzenAuthorizationFactory#create
        takes plain constructor arguments, not @ConfigProperty-annotated fields - each consuming
        product's own framework-binding module reads its own config property names and calls this
        factory, rather than this module knowing any product's config namespace.
    </description>
    <dependencies>
        <dependency>
            <groupId>com.forwardmeasure.authzen</groupId>
            <artifactId>forwardmeasure-authzen-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.authzen</groupId>
            <artifactId>forwardmeasure-authzen-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
